    given-names: Matteo
  - name: Pillow-AllSIMD contributors
repository-code: https://github.com/desmoteo/pillow-allsimd
url: https://desmoteo.github.io/pillow-allsimd/
license: MIT-CMU
version: 13.0.0.post0
keywords:
  - imaging
  - image processing
  - SIMD
  - AVX2
  - NEON
  - Python
